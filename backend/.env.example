# Configure at least one provider. They're tried in this order.

# 1. Free-tier providers, called directly. Comma-separate several keys per
#    provider; they rotate and each rate-limited key is skipped for a while.
GROQ_API_KEYS=
GEMINI_API_KEYS=
OPENROUTER_API_KEYS=
COHERE_API_KEYS=
MISTRAL_API_KEYS=
CEREBRAS_API_KEYS=
# Optional: override the provider/model chains (see app/config.py for defaults)
# OPENAI_MODELS=groq/openai/gpt-oss-120b,gemini/gemini-3.8-flash,...
# OPENAI_FAST_MODELS=groq/qwen/qwen3.8-27b,...

#    Or send the same chains through an OpenAI-compatible gateway such as a
#    self-hosted OmniRoute (npx omniroute):
OPENAI_BASE_URL=
OPENAI_API_KEY=

# 2. Google Gemini (AI Studio key)
GEMINI_API_KEY=

# 3. Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 4. Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

CORS_ORIGINS=http://localhost:3000
# Vercel production + preview URLs are allowed by default via CORS_ORIGIN_REGEX
RETRIEVAL_TOP_K=6
RETRIEVAL_PRECEDENT_K=2

# Time budgets (seconds) — the app answers with the matching provisions if no model responds in time
ANALYZE_BUDGET_S=8
FIRST_TOKEN_BUDGET_S=30
