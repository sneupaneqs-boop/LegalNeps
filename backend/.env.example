# Configure at least one provider. They're tried in this order.

# 1. OpenAI-compatible gateway, e.g. self-hosted OmniRoute (npx omniroute)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODELS=auto
OPENAI_FAST_MODELS=auto/fast

# 2. Google Gemini (AI Studio key)
GEMINI_API_KEY=

# 3. Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 4. Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

CORS_ORIGINS=http://localhost:3000
RETRIEVAL_TOP_K=6
RETRIEVAL_PRECEDENT_K=2

# Time budgets (seconds) — the app answers with the matching provisions if no model responds in time
ANALYZE_BUDGET_S=8
FIRST_TOKEN_BUDGET_S=30
