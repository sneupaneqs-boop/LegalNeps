# Node
node_modules/
frontend/.next/
frontend/out/
npm-debug.log*

# Python
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
*.pyc

# Env
.env
.env.local
backend/.env
frontend/.env.local

# OS
.DS_Store

# Scraped law-commission corpus (large binary dump, not meant for git)
sources/lawcommission/

# Scraped NKP precedents (large raw dump)
sources/nkp/

# Raw regulator downloads (PDFs, logs); the per-authority manifest.jsonl files stay tracked
sources/regulators/*/files/
sources/regulators/_logs/
sources/regulators/_glyphref/

# Intermediate extraction output and runtime index cache
sources/processed/
backend/app/data/index_cache/
frontend/tsconfig.tsbuildinfo
backend/eval/reports/

# graphify: keep the graph deliverables (graph.json, graph.html, GRAPH_REPORT.md,
# manifest.json) tracked so other Claude sessions get them without an LLM key;
# ignore its own internal cache/bookkeeping and dated backup snapshots.
graphify-out/cache/
graphify-out/20*/
graphify-out/.graphify_*

# Downloaded official PDFs used to transcribe prescribed drafting formats
sources/formats/
