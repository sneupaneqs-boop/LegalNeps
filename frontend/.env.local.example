NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase auth (S5). These are the publishable anon key + project URL -
# safe to ship in client-side JS by design (Supabase's RLS policies are
# what actually protect data, not secrecy of this key). Get them from your
# project's Settings -> API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
